# ==============================================================================
# RAASTAH (راستہ) — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your local or production settings.
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174,https://raastah.vercel.app

# Database Connection (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/raastah?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_jwt_secret_key
SESSION_SECRET=replace_with_a_random_session_secret

# Initial Super Admin Provisioning (Auto-seeded on first server run)
BOOTSTRAP_ADMIN_EMAIL=admin@raastah.pk
BOOTSTRAP_ADMIN_PASSWORD=your_secure_admin_password
BOOTSTRAP_ADMIN_NAME=Super Admin
ALLOW_DEMO_OPERATOR_SEED=true

# ==============================================================================
# RAASTAH AI EXPEDITION COPILOT (Google Gemini API)
# Get a free key at: https://aistudio.google.com/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash

# Optional OpenAI-compatible Endpoint Fallback
PUBLIC_AI_ENDPOINT=
PUBLIC_AI_MODEL=
PUBLIC_AI_API_KEY=
